# Rendered at container start by the nginx image's envsubst step (BAYORA_* variables only).
server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;

    # The UI is published on 127.0.0.1 only. Any other Host means a DNS-rebinding page or a
    # misrouted request, and must never be answered with the operator credential attached.
    if ($host !~* ^(127\.0\.0\.1|localhost)$) {
        return 421;
    }

    # The operator console must not be framed by another site (clickjacking).
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Role interfaces exist for role agents on their own networks, never for the browser.
    location ~ ^/api/(red|blue|target)/ {
        return 403;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # The operator credential lives only here. Any client-supplied header is replaced.
        proxy_set_header Authorization "Bearer ${BAYORA_TOKEN_OPERATOR}";
        # One "advance" request runs a whole stage. With a live reasoning model a stage can take
        # many minutes (qwen3:4b: about 11 minutes for seven prompts on an M3).
        proxy_read_timeout 1800s;
    }

    location / {
        try_files $uri /index.html;
    }
}
