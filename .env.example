# Copy to .env (git-ignored) for `docker compose`, or better, let the bootstrap create
# every value with strong randomness (it only appends what is missing):
#   cd backend && uv run python -m app.keys ../.env
# Compose refuses to start if any Docker value below is missing, and the API refuses to
# start on a plaintext operator token, static role tokens or missing keys.

# Operator: nginx (Docker) or the Vite proxy (dev) injects it; the browser never sees it.
# The backend holds only its SHA-256 hash.
BAYORA_TOKEN_OPERATOR=change-me-operator-token-000000
BAYORA_OPERATOR_TOKEN_SHA256=<sha256 hex of BAYORA_TOKEN_OPERATOR>

# Ed25519 keys, "kid:base64url(raw 32 bytes)". Public key lists are comma separated so a
# key can be rotated (app.keys --rotate red|blue|cp).
BAYORA_CP_SIGNING_KEY=<control plane only>
BAYORA_CP_PUBLIC_KEYS=<agents and target>
BAYORA_RED_SIGNING_KEY=<red-agent only>
BAYORA_RED_PUBLIC_KEYS=<control plane>
BAYORA_BLUE_SIGNING_KEY=<blue-agent only>
BAYORA_BLUE_PUBLIC_KEYS=<control plane>

# Shared only by the API and the audit witness.
BAYORA_WITNESS_TOKEN=change-me-witness-token-000000000
# Database owner (db and the one-shot migrate job only) and the runtime role bayora_app (API).
POSTGRES_PASSWORD=change-me-postgres-password
BAYORA_APP_DB_PASSWORD=change-me-app-db-password-0000000

# Optional: UI port on 127.0.0.1 (default 8080).
# BAYORA_UI_PORT=8080

# No longer used (static role tokens were replaced by signed keys); safe to delete:
# BAYORA_TOKEN_RED, BAYORA_TOKEN_BLUE, BAYORA_TOKEN_TARGET

# Local development without Docker needs none of the above: the API falls back to dev
# tokens and in-process roles. Optional local settings:
# DATABASE_URL=postgresql:///bayora?host=/tmp   # unset = SQLite file backend/bayora.db
# BAYORA_WITNESS_URL / BAYORA_WITNESS_TOKEN      # point at a locally run witness
