# Copy to .env (git-ignored) for `docker compose`. Compose refuses to start if any of the
# Docker values below is missing, and the API refuses dev defaults or short tokens there.
# Generate real values with:
#   python3 -c "import secrets; [print(f'{k}={secrets.token_urlsafe(32)}') for k in ('BAYORA_TOKEN_OPERATOR','BAYORA_TOKEN_RED','BAYORA_TOKEN_BLUE','BAYORA_TOKEN_TARGET','BAYORA_WITNESS_TOKEN','POSTGRES_PASSWORD')]" > .env

# One bearer token per role (24+ characters, all distinct). The browser never sees any of
# them: nginx (Docker) or the Vite proxy (dev) injects the operator token server-side.
BAYORA_TOKEN_OPERATOR=change-me-operator-token-000000
BAYORA_TOKEN_RED=change-me-red-token-0000000000000
BAYORA_TOKEN_BLUE=change-me-blue-token-000000000000
BAYORA_TOKEN_TARGET=change-me-target-token-0000000000

# Shared only by the API and the audit witness.
BAYORA_WITNESS_TOKEN=change-me-witness-token-000000000
POSTGRES_PASSWORD=change-me-postgres-password

# Optional: UI port on 127.0.0.1 (default 8080).
# BAYORA_UI_PORT=8080

# Local development without Docker needs none of the above: the API falls back to dev
# tokens and in-process roles. Optional local settings:
# DATABASE_URL=postgresql:///bayora?host=/tmp   # unset = SQLite file backend/bayora.db
# BAYORA_WITNESS_URL / BAYORA_WITNESS_TOKEN      # point at a locally run witness
